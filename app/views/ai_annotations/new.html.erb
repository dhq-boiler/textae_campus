<%= form_with model: @new_ai_annotation, class: "ai-annotation-form", data: { controller: "ai-annotation-form llm-selector", action: "input->ai-annotation-form#updateSubmitButton", llm_selector_url_value: "http://localhost:3000/api/llm_api_keys/", llm_selector_jwt_token_value: @jwt_token } do |f| %>
  <div class="text-field">
    <label>Text</label>
    <%= f.textarea :text, required: true, rows: 15, placeholder: "Write or paste text here", data: { ai_annotation_form_target: "text" } %>
  </div>

  <div class="prompt-field">
    <label>Prompt</label>
    <%= f.textarea :prompt, required: true, rows: 3, placeholder: "Order how to annotate the text", data: { ai_annotation_form_target: "prompt" } %>
  </div>

  <div class="submit-row">
    <div class="api-key-field">
      <label>API Key</label>
      <%= select_tag :api_key_uuid, options_for_select([]),
          { required: true,
            data: { llm_selector_target: "apiKeySelect", action: "change->llm-selector#apiKeyChanged change->ai-annotation-form#updateSubmitButton" } } %>
    </div>

    <div class="model-field">
      <label>LLM model</label>
      <%= select_tag :model, options_for_select([["APIキーを先に選択してください", ""]]),
          { required: true, disabled: true,
            data: { llm_selector_target: "modelSelect", action: "change->ai-annotation-form#updateSubmitButton" } } %>
    </div>

    <div class="submit-field">
      <%= f.submit "Annotate", disabled: true, class: "button", data: { ai_annotation_form_target: "submit" } %>
    </div>
  </div>
<% end %>
